# Variables de entorno — Witme Lens
#
# Fase 0 no usa ninguna. No rellenes secretos aquí.
# En Fase 1 harán falta (valores solo de ejemplo de nombres, sin credenciales):

# Supabase (PostgreSQL, Auth, Storage). La service role NUNCA en NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dominio o dominios Google permitidos. Confirmar con el equipo (provisional).
ALLOWED_GOOGLE_DOMAINS=

# Google Cloud OAuth (se configura en el proveedor Google de Supabase Auth).
# Documentar URL de redirección de cada entorno al crear las credenciales.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

